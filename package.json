{
  "name": "temin360-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:desktop": "pnpm --filter app-desktop dev",
    "dev:web": "pnpm --filter app-web dev",
    "dev:website": "pnpm --filter app-landing dev",
    "dev": "pnpm dev:desktop",
    "db:up": "docker compose up -d db pocketbase",
    "db:down": "docker compose down",
    "pb:up": "node scripts/start-pocketbase.js",
    "pb:docker": "docker compose up -d pocketbase",
    "pb:down": "docker compose stop pocketbase",
    "prisma:generate": "pnpm --filter app-web prisma:generate",
    "prisma:push": "pnpm --filter app-web prisma:push",
    "prisma:seed": "pnpm --filter app-web prisma:seed",
    "prisma:studio": "pnpm --filter app-web prisma:studio",
    "build:desktop": "pnpm --filter app-desktop build",
    "build:web": "pnpm --filter app-web build",
    "build:website": "pnpm --filter app-landing build",
    "typecheck:desktop": "pnpm --filter app-desktop typecheck",
    "typecheck:web": "pnpm --filter app-web build",
    "typecheck": "pnpm typecheck:desktop && pnpm typecheck:web",
    "test": "pnpm --filter app-desktop test",
    "test:watch": "pnpm --filter app-desktop test:watch",
    "format": "pnpm --filter app-desktop format",
    "lint": "pnpm --filter app-desktop lint && pnpm --filter app-web lint",
    "rebuild:electron": "npx @electron/rebuild -v 39.8.10 -f -w better-sqlite3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}